# =============================================================================
# LoOper phone client — source-only
# =============================================================================
# Only the source is tracked: core/ (the cross-platform Bare client), the Gradle
# build files, AndroidManifest.xml, the Kotlin source, and the manifests
# (package.json / pear.json).  Everything below is generated by npm / Gradle /
# bare-link / bare-pack / Arrow_setup.bat and can be recreated at any time.
# =============================================================================

# --- Node.js -----------------------------------------------------------------
node_modules/

# --- IDE / editor / OS -------------------------------------------------------
.idea/
*.iml
.DS_Store
Thumbs.db

# --- Gradle / Android build outputs -----------------------------------------
android/.gradle/
android/build/
android/app/build/
android/.cxx/
android/captures/
android/local.properties
*.apk
*.aab
*.ap_
*.dex

# --- Gradle wrapper (regenerated by Arrow_setup.bat step 0c) -----------------
# Kept out so the repo stays source-only; Arrow_setup.bat runs `gradle wrapper`.
android/gradlew
android/gradlew.bat
android/gradle/

# --- Generated by the phone build -------------------------------------------
# bare-kit prebuild (gh release), linked native addons (bare-link) and the JS
# bundle (bare-pack) - all recreated by build_pipeline/build_phone_apk.ps1.
android/app/libs/bare-kit/
android/app/src/main/addons/
android/app/src/main/assets/app.bundle

# --- Signing secrets ---------------------------------------------------------
*.keystore
*.jks
keystore.properties

# --- Native libraries --------------------------------------------------------
*.so
*.jar
