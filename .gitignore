# =============================================================================
# arrow / LoOper — source-only repository
# =============================================================================
# Excludes everything that is NOT the app's own source: vendored engines and
# third-party sandboxes under utils/, model weights, native binaries, build
# outputs, virtual-environments, caches, logs and runtime data.
#
# -----------------------------------------------------------------------------
# IMPORTANT — NESTED GIT REPOSITORIES
# -----------------------------------------------------------------------------
# The vendored trees kept below (utils/llama.cpp, utils/nano-graphrag,
# utils/rdpwrap) each ship their own .git/ directory.
# Git records a directory containing .git/ as a submodule "gitlink" and will
# NOT commit its files.  To commit their contents as plain files, delete the
# nested .git folders first (PowerShell), then stage again:
#
#   Remove-Item -Recurse -Force `
#       utils\llama.cpp\.git, utils\nano-graphrag\.git, utils\rdpwrap\.git
# =============================================================================

# -----------------------------------------------------------------------------
# Virtual environments & installed packages (any depth, not just top level)
# -----------------------------------------------------------------------------
.venv/
venv/
ENV/
env/
**/site-packages/
**/node_modules/
*.egg-info/
*.egg/

# -----------------------------------------------------------------------------
# Python bytecode & tool caches  (ALL levels — matches the request)
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
.cache/

